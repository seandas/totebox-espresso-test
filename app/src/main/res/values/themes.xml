<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Totebox" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="Totebox.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:theme">@style/ThemeOverlay.MaterialComponents.Dark.ActionBar</item>
        <!-- The overflow menu is a light popup, so it needs dark text (not the toolbar's white) -->
        <item name="popupTheme">@style/ThemeOverlay.Material3.Light</item>
    </style>

    <style name="Totebox.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Totebox.SectionTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>
</resources>
