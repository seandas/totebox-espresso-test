<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Totebox">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ProductsActivity" android:exported="false" />
        <activity android:name=".ui.ProductDetailActivity" android:exported="false" />
        <activity android:name=".ui.CartActivity" android:exported="false" />
        <activity
            android:name=".ui.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.OrderCompleteActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
    </application>
</manifest>
